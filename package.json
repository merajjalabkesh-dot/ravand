{
  "name": "ravand",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-sw.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "cap:sync": "npm run build && node scripts/prune-cap-dist.mjs && cap sync",
    "cap:copy": "npm run build && node scripts/prune-cap-dist.mjs && cap copy",
    "cap:android": "cap open android",
    "cap:apk": "npm run build && node scripts/prune-cap-dist.mjs && cap sync && cd android && gradlew.bat assembleDebug",
    "cap:apk:release": "npm run build && node scripts/prune-cap-dist.mjs && cap sync && cd android && gradlew.bat assembleRelease",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:5175 && electron .\"",
    "electron:build": "npm run build && node scripts/prune-cap-dist.mjs && electron-builder"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "framer-motion": "^11.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "vite": "^6.0.0"
  },
  "main": "electron.cjs",
  "build": {
    "appId": "com.ravand.app",
    "productName": "Ravand",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron.cjs",
      "!node_modules/**"
    ],
    "electronLanguages": ["en-US", "fa"],
    "win": {
      "target": "nsis",
      "icon": "src-tauri/icons/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Ravand-Setup.exe",
      "shortcutName": "Ravand",
      "installerIcon": "src-tauri/icons/icon.ico"
    }
  },
  "description": "Ravand — daily habits, journal and life tracker",
  "author": "Ravand"
}
