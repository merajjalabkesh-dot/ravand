# Server
PORT=4000
# JWT secret — set a long random string here
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES=7d

# Gmail / SMTP for OTP email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_otp_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=روید <your_otp_email@gmail.com>

# Optional: push the frontend static build from ../dist when set
# FRONTEND_DIR=../dist