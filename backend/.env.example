# Server
PORT=4000
# در production حتماً NODE_ENV=production بگذارید تا اگر JWT_SECRET ست نشده بود
# سرور به‌جای بالا آمدن با مقدار پیش‌فرض، فوراً خطا بدهد.
NODE_ENV=production
# JWT secret — set a long random string here
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES=7d

# CORS — اگر خالی بماند همهٔ originها مجازند (رفتار قبلی).
# برای سخت‌گیری، دامنه‌ها را با کاما جدا کنید:
# CORS_ORIGINS=https://your-site.com,https://localhost,tauri://localhost
CORS_ORIGINS=

# Gmail / SMTP for OTP email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_otp_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=روید <your_otp_email@gmail.com>

# Optional: push the frontend static build from ../dist when set
# FRONTEND_DIR=../dist