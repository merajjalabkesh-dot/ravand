# Local stage backups — kept on disk as rollback points, not in git
backup/

# Tauri (Windows .exe build)
src-tauri/target/
src-tauri/gen/

# Capacitor (Android .apk build) — the android/ folder is generated by
# `npx cap add android`; regenerate it on each machine rather than committing it.
android/
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/app/src/main/assets/public/

# Built binaries — too large for git; users download them from /downloads
public/downloads/*.exe
public/downloads/*.apk
public/downloads/*.dmg
dist_electron/
*.asar
